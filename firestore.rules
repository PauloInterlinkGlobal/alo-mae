// ==========================================================
// Regras de Segurança Firestore (rules_version = '2')
// Aplicação: "Alô Mãe" (v3) - Plataforma de Monitorização Escolar
// Perfis: pai, professor, instituicao, terminal
// ==========================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Bloqueio absoluto por omissão na raiz (Zero-Trust)
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================================
    // Funções Auxiliares Reutilizáveis (RBAC & Multi-tenancy)
    // ==========================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function getRole() {
      return request.auth.token.role;
    }

    function getSchoolId() {
      return request.auth.token.schoolId;
    }

    function getClassIds() {
      return request.auth.token.classIds;
    }

    function getStudentIds() {
      return request.auth.token.studentIds;
    }

    function getSchoolIds() {
      return request.auth.token.schoolIds;
    }

    function isPai() {
      return isSignedIn() && (getRole() == 'pai' || getRole() == 'encarregado');
    }

    function isProfessor() {
      return isSignedIn() && getRole() == 'professor';
    }

    function isInstituicao() {
      return isSignedIn() && (getRole() == 'instituicao' || getRole() == 'admin');
    }

    function isTerminal() {
      return isSignedIn() && getRole() == 'terminal';
    }

    // Perfis de escola única (instituicao, professor, terminal)
    function sameSchool(targetSchoolId) {
      return getSchoolId() != null && getSchoolId() == targetSchoolId;
    }

    // Pai com filhos em VÁRIAS escolas -> claim schoolIds (array)
    function hasSchoolAccess(targetSchoolId) {
      return isPai() && (
        (getSchoolIds() != null && targetSchoolId in getSchoolIds()) ||
        (getSchoolId() != null && getSchoolId() == targetSchoolId)
      );
    }

    function teachesClass(targetClassId) {
      return isProfessor() && (
        (getClassIds() != null && targetClassId in getClassIds()) ||
        (request.auth.token.assignedClassIds != null && targetClassId in request.auth.token.assignedClassIds)
      );
    }

    function isOwnChild(targetStudentId) {
      return isPai() && (
        (request.auth.token.studentId != null && request.auth.token.studentId == targetStudentId) ||
        (getStudentIds() != null && targetStudentId in getStudentIds())
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ==========================================================
    // 1. Coleção: classes/{classId} [NOVO v3]
    //    Entidade mestre de turmas: só a instituição edita;
    //    professor e pai só leem as suas turmas.
    // ==========================================================
    match /classes/{classId} {
      // Leitura pontual
      allow get: if (isInstituicao() && sameSchool(existing().schoolId)) ||
                    (isProfessor() && sameSchool(existing().schoolId) && teachesClass(classId)) ||
                    (isPai() && hasSchoolAccess(existing().schoolId)) ||
                    (isTerminal() && sameSchool(existing().schoolId));

      // NOTA LISTAGEM: A query do cliente no frontend tem de filtrar por:
      //   - Instituição: .where('schoolId', '==', getSchoolId())
      //   - Professor: .where('schoolId', '==', getSchoolId()).where('teacherIds', 'array-contains', request.auth.uid)
      //   - Pai: .where('schoolId', 'in', getSchoolIds())
      allow list: if (isInstituicao() && resource.data.schoolId == getSchoolId()) ||
                     (isProfessor() && resource.data.schoolId == getSchoolId() && (classId in getClassIds() || request.auth.uid in resource.data.teacherIds)) ||
                     (isPai() && hasSchoolAccess(resource.data.schoolId)) ||
                     (isTerminal() && resource.data.schoolId == getSchoolId());

      allow create: if isInstituicao() &&
                       incoming().schoolId == getSchoolId() &&
                       isValidId(classId);

      allow update: if isInstituicao() &&
                       sameSchool(existing().schoolId) &&
                       incoming().schoolId == existing().schoolId;

      allow delete: if isInstituicao() && sameSchool(existing().schoolId);
    }

    // ==========================================================
    // 2. Coleção: users/{userId}
    // ==========================================================
    match /users/{userId} {
      allow get: if isOwner(userId) ||
                    (isInstituicao() && (existing().schoolId == getSchoolId() || (existing().schoolIds != null && getSchoolId() in existing().schoolIds))) ||
                    (isProfessor() && existing().role == 'pai' && existing().schoolId == getSchoolId());

      allow list: if (isInstituicao() && (resource.data.schoolId == getSchoolId() || (resource.data.schoolIds != null && getSchoolId() in resource.data.schoolIds))) ||
                     (isProfessor() && resource.data.role == 'pai' && resource.data.schoolId == getSchoolId());

      allow create: if isInstituicao() &&
                       (incoming().schoolId == getSchoolId() || (incoming().schoolIds != null && getSchoolId() in incoming().schoolIds)) &&
                       incoming().id == userId &&
                       incoming().role in ['pai', 'professor', 'instituicao', 'encarregado'];

      // Utilizador só altera dados de contacto; nunca permissões ou studentIds
      allow update: if (
        isOwner(userId) &&
        incoming().role == existing().role &&
        incoming().id == existing().id &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'avatarUrl', 'telefone', 'nome'])
      ) || (
        isInstituicao() &&
        (existing().schoolId == getSchoolId() || (existing().schoolIds != null && getSchoolId() in existing().schoolIds))
      );

      allow delete: if isInstituicao() &&
                       (existing().schoolId == getSchoolId() || (existing().schoolIds != null && getSchoolId() in existing().schoolIds));
    }

    // ==========================================================
    // 3. Coleção: students/{studentId}
    // ==========================================================
    match /students/{studentId} {
      allow get: if isOwnChild(studentId) ||
                    (isPai() && (existing().parentUid == request.auth.uid || existing().parentEmail == request.auth.token.email)) ||
                    (isProfessor() && sameSchool(existing().schoolId) && teachesClass(existing().classId)) ||
                    (isInstituicao() && sameSchool(existing().schoolId)) ||
                    (isTerminal() && sameSchool(existing().schoolId));

      // NOTA LISTAGEM: A query do cliente TEM de incluir:
      //   - Instituição: .where('schoolId', '==', getSchoolId())
      //   - Professor: .where('schoolId', '==', getSchoolId()).where('classId', 'in', getClassIds())
      //   - Pai: .where('parentUid', '==', request.auth.uid)
      allow list: if (isProfessor() && resource.data.schoolId == getSchoolId() && resource.data.classId in getClassIds()) ||
                     (isInstituicao() && resource.data.schoolId == getSchoolId()) ||
                     (isPai() && (isOwnChild(resource.data.id) || resource.data.parentUid == request.auth.uid || resource.data.parentEmail == request.auth.token.email)) ||
                     (isTerminal() && resource.data.schoolId == getSchoolId());

      allow create: if isInstituicao() &&
                       incoming().schoolId == getSchoolId() &&
                       isValidId(studentId);

      allow update: if (
        // Instituição gere o registo do aluno da sua escola
        isInstituicao() &&
        sameSchool(existing().schoolId) &&
        incoming().schoolId == existing().schoolId
      ) || (
        // Professor só atualiza status de assiduidade e timestamps
        isProfessor() &&
        sameSchool(existing().schoolId) &&
        teachesClass(existing().classId) &&
        incoming().schoolId == existing().schoolId &&
        incoming().classId == existing().classId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lastEntryTime', 'lastExitTime'])
      );

      allow delete: if isInstituicao() && sameSchool(existing().schoolId);
    }

    // ==========================================================
    // 4. Coleção: accessLogs/{logId}
    // ==========================================================
    match /accessLogs/{logId} {
      allow get: if (isPai() && (isOwnChild(existing().studentId) || existing().notifiedRecipient == request.auth.token.email)) ||
                    (isProfessor() && sameSchool(existing().schoolId) && teachesClass(existing().classId)) ||
                    (isInstituicao() && sameSchool(existing().schoolId));

      allow list: if (isInstituicao() && resource.data.schoolId == getSchoolId()) ||
                     (isProfessor() && resource.data.schoolId == getSchoolId() && resource.data.classId in getClassIds()) ||
                     (isPai() && isOwnChild(resource.data.studentId));

      allow create: if (isTerminal() || isInstituicao()) &&
                       incoming().schoolId == getSchoolId() &&
                       isValidId(logId);

      // Registos de controlo de acessos são estritamente IMUTÁVEIS
      allow update: if false;

      allow delete: if isInstituicao() && sameSchool(existing().schoolId);
    }

    // ==========================================================
    // 5. Coleção: notifications/{notificationId}
    // ==========================================================
    match /notifications/{notificationId} {
      allow get: if (isPai() && hasSchoolAccess(existing().schoolId) && (isOwnChild(existing().studentId) || existing().type == 'broadcast' || existing().targetUserUid == request.auth.uid)) ||
                    (isProfessor() && sameSchool(existing().schoolId) && (existing().classId == null || teachesClass(existing().classId))) ||
                    (isInstituicao() && sameSchool(existing().schoolId));

      allow list: if (isInstituicao() && resource.data.schoolId == getSchoolId()) ||
                     (isProfessor() && resource.data.schoolId == getSchoolId() && (resource.data.classId == null || resource.data.classId in getClassIds())) ||
                     (isPai() && hasSchoolAccess(resource.data.schoolId) && (isOwnChild(resource.data.studentId) || resource.data.type == 'broadcast' || resource.data.targetUserUid == request.auth.uid));

      allow create: if (
        isInstituicao() &&
        incoming().schoolId == getSchoolId()
      ) || (
        isProfessor() &&
        incoming().schoolId == getSchoolId() &&
        incoming().senderRole == 'professor' &&
        incoming().type in ['reunion', 'warning', 'praise'] &&
        teachesClass(incoming().classId)
      );

      allow update: if (
        // Pai só altera o estado de leitura (isRead)
        isPai() &&
        hasSchoolAccess(existing().schoolId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
      ) || (
        isInstituicao() &&
        sameSchool(existing().schoolId) &&
        incoming().schoolId == existing().schoolId
      );

      allow delete: if isInstituicao() && sameSchool(existing().schoolId);
    }

    // ==========================================================
    // 6. Coleção: medicalClinics/{clinicId}
    //    Catálogo geral público; terminal sem acesso
    // ==========================================================
    match /medicalClinics/{clinicId} {
      allow get, list: if isSignedIn() && !isTerminal();
      allow create, update, delete: if isInstituicao();
    }

    // ==========================================================
    // 7. Coleção: classStats/{classId}
    // ==========================================================
    match /classStats/{classId} {
      allow get, list: if (isInstituicao() && sameSchool(existing().schoolId)) ||
                           (isProfessor() && sameSchool(existing().schoolId) && teachesClass(classId));
      allow create, update: if isInstituicao() && sameSchool(incoming().schoolId);
      allow delete: if isInstituicao() && sameSchool(existing().schoolId);
    }

    // ==========================================================
    // 8. Coleção: miniPautas/{pautaId}
    //    Fluxo: Professor cria (draft/submitted) -> Instituição aprova/rejeita
    //    Pai só visualiza pautas com status == 'approved'
    // ==========================================================
    match /miniPautas/{pautaId} {
      allow get: if (isOwnChild(existing().studentId) && hasSchoolAccess(existing().schoolId) && existing().status == 'approved') ||
                    (isProfessor() && sameSchool(existing().schoolId) && teachesClass(existing().classId)) ||
                    (isInstituicao() && sameSchool(existing().schoolId));

      // NOTA CRÍTICA LISTAGEM: O cliente do Pai tem de filtrar:
      //   .where('status', '==', 'approved')
      allow list: if (isPai() && hasSchoolAccess(resource.data.schoolId) && resource.data.status == 'approved' && isOwnChild(resource.data.studentId)) ||
                     (isProfessor() && resource.data.schoolId == getSchoolId() && resource.data.classId in getClassIds()) ||
                     (isInstituicao() && resource.data.schoolId == getSchoolId());

      allow create: if isProfessor() &&
                       incoming().schoolId == getSchoolId() &&
                       teachesClass(incoming().classId) &&
                       incoming().professorId == request.auth.uid &&
                       incoming().status in ['draft', 'submitted'];

      allow update: if (
        // Professor só edita em draft/submitted; NUNCA pode alterar para approved ou rejected
        isProfessor() &&
        sameSchool(existing().schoolId) &&
        teachesClass(existing().classId) &&
        existing().professorId == request.auth.uid &&
        existing().status in ['draft', 'submitted'] &&
        incoming().status in ['draft', 'submitted'] &&
        incoming().schoolId == existing().schoolId &&
        incoming().classId == existing().classId &&
        incoming().studentId == existing().studentId &&
        incoming().professorId == existing().professorId
      ) || (
        // Instituição é quem aprova ou rejeita
        isInstituicao() &&
        sameSchool(existing().schoolId) &&
        incoming().schoolId == existing().schoolId &&
        incoming().classId == existing().classId &&
        incoming().studentId == existing().studentId
      );

      allow delete: if isInstituicao() && sameSchool(existing().schoolId) && existing().status != 'approved';
    }

    // ==========================================================
    // 9. Coleção: insurancePolicies/{policyId}
    //    Base da Guia Médica: apólices e coberturas
    //    Professor e Terminal sem acesso (sigilo médico)
    // ==========================================================
    match /insurancePolicies/{policyId} {
      allow get: if (isOwnChild(existing().studentId) && hasSchoolAccess(existing().schoolId)) ||
                    (isInstituicao() && sameSchool(existing().schoolId));

      allow list: if (isPai() && hasSchoolAccess(resource.data.schoolId) && isOwnChild(resource.data.studentId)) ||
                     (isInstituicao() && resource.data.schoolId == getSchoolId());

      allow create, update: if isInstituicao() && sameSchool(incoming().schoolId);
      allow delete: if isInstituicao() && sameSchool(existing().schoolId);
    }

    // ==========================================================
    // 10. Coleção: terminals/{terminalId}
    // ==========================================================
    match /terminals/{terminalId} {
      allow get: if isSignedIn() && (isInstituicao() || isTerminal());
      allow list: if isInstituicao() && resource.data.schoolId == getSchoolId();
      allow write: if isInstituicao() && incoming().schoolId == getSchoolId();
    }
  }
}
