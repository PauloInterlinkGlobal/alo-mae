// ==========================================================
// Regras de Segurança Firestore (rules_version = '2')
// Aplicação: "Alô Mãe" (v3) - Plataforma de Monitorização Escolar & Chat Interno
// Perfis: pai, professor, instituicao, terminal
// ==========================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function getRole() {
      return request.auth.token.role;
    }

    function getSchoolId() {
      return request.auth.token.schoolId;
    }

    // ==========================================================
    // 1. Coleções de Turmas (classes e turmas)
    // ==========================================================
    match /classes/{classId} {
      allow read: if true;
      allow write: if true;
    }

    match /turmas/{turmaId} {
      allow read: if true;
      allow write: if true;
    }

    match /turmas_professores/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // ==========================================================
    // 2. Coleção: users/{userId}
    // ==========================================================
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // ==========================================================
    // 3. Coleção: students/{studentId}
    // ==========================================================
    match /students/{studentId} {
      allow read: if true;
      allow write: if true;
    }

    // ==========================================================
    // 4. Coleção: accessLogs/{logId}
    // ==========================================================
    match /accessLogs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSignedIn();
    }

    // ==========================================================
    // 5. Coleção: notifications/{notificationId}
    // ==========================================================
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if true;
    }

    // ==========================================================
    // 6. Coleção: medicalClinics/{clinicId}
    // ==========================================================
    match /medicalClinics/{clinicId} {
      allow read: if true;
      allow write: if true;
    }

    // ==========================================================
    // 7. Coleção: classStats/{classId}
    // ==========================================================
    match /classStats/{classId} {
      allow read: if true;
      allow write: if true;
    }

    // ==========================================================
    // 8. Coleção: miniPautas e mini_pautas
    // ==========================================================
    match /miniPautas/{pautaId} {
      allow read: if true;
      allow write: if true;
    }

    match /mini_pautas/{pautaId} {
      allow read: if true;
      allow write: if true;
    }

    match /grades/{gradeId} {
      allow read: if true;
      allow write: if true;
    }

    // ==========================================================
    // 9. Coleção: insurancePolicies & studentMedical
    // ==========================================================
    match /insurancePolicies/{policyId} {
      allow read: if true;
      allow write: if true;
    }

    match /studentMedical/{studentId} {
      allow read: if true;
      allow write: if true;
    }

    // ==========================================================
    // 10. Coleção: terminals/{terminalId}
    // ==========================================================
    match /terminals/{terminalId} {
      allow read: if true;
      allow write: if true;
    }

    // ==========================================================
    // 11. Coleção: teacherListings/{listingId}
    //     Mural de Aulas Particulares e Explicações
    // ==========================================================
    match /teacherListings/{listingId} {
      allow read: if true;
      allow write: if true;
    }

    // ==========================================================
    // 12. Coleção: conversations/{conversationId} (Chat Interno)
    //     Comunicação Professor ↔ Encarregado vinculada ao Educando
    // ==========================================================
    match /conversations/{conversationId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn();

      // Subcoleção de Mensagens
      match /messages/{messageId} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if isSignedIn();
      }
    }
  }
}
