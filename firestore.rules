rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================================
    // Helper Functions (RBAC, Multi-tenancy & Custom Claims)
    // ==========================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getRole() {
      return request.auth.token.role != null
        ? request.auth.token.role
        : (userExists() ? getUserDoc().role : 'pai');
    }

    function getSchoolId() {
      return request.auth.token.schoolId != null
        ? request.auth.token.schoolId
        : (userExists() && getUserDoc().schoolId != null ? getUserDoc().schoolId : null);
    }

    function isInstituicao() {
      return isSignedIn() && (getRole() == 'instituicao' || getRole() == 'admin' || request.auth.token.admin == true);
    }

    function isProfessor() {
      return isSignedIn() && (getRole() == 'professor');
    }

    function isPai() {
      return isSignedIn() && (getRole() == 'pai' || getRole() == 'encarregado');
    }

    function isTerminal() {
      return isSignedIn() && (getRole() == 'terminal');
    }

    function isParentOfStudent(studentId) {
      return isPai() && (
        (request.auth.token.studentIds != null && studentId in request.auth.token.studentIds) ||
        (request.auth.token.studentId != null && request.auth.token.studentId == studentId) ||
        (userExists() && getUserDoc().studentIds != null && studentId in getUserDoc().studentIds) ||
        (userExists() && getUserDoc().studentId != null && getUserDoc().studentId == studentId) ||
        (userExists() && getUserDoc().childrenIds != null && studentId in getUserDoc().childrenIds)
      );
    }

    function isTeacherOfClass(classId) {
      return isProfessor() && (
        (request.auth.token.classIds != null && classId in request.auth.token.classIds) ||
        (userExists() && getUserDoc().classIds != null && classId in getUserDoc().classIds)
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ==========================================================
    // 1. Coleção: users/{userId}
    // ==========================================================
    match /users/{userId} {
      allow get: if isOwner(userId) || isInstituicao() || (isProfessor() && existing().role == 'pai' && (getSchoolId() == null || existing().schoolId == getSchoolId()));
      allow list: if isInstituicao() || (isProfessor() && resource.data.role == 'pai' && (getSchoolId() == null || resource.data.schoolId == getSchoolId())) || isOwner(userId);

      allow create: if isInstituicao() || (isOwner(userId) && incoming().role in ['pai', 'professor', 'instituicao', 'encarregado']);

      allow update: if (
        isOwner(userId) &&
        incoming().role == existing().role &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'avatarUrl', 'nome', 'telefone', 'updatedAt', 'title', 'studentId', 'studentIds', 'childrenIds', 'classIds'])
      ) || isInstituicao();

      allow delete: if isInstituicao();
    }

    // ==========================================================
    // 2. Coleção: students/{studentId}
    // ==========================================================
    match /students/{studentId} {
      allow get, list: if isInstituicao() ||
                          (isProfessor() && (getSchoolId() == null || resource.data.schoolId == getSchoolId())) ||
                          (isPai() && (isParentOfStudent(studentId) || (request.auth.token.email != null && resource.data.parentEmail == request.auth.token.email))) ||
                          isTerminal();

      allow create: if isInstituicao() && isValidId(studentId);

      allow update: if isInstituicao() ||
                       (isProfessor() && (getSchoolId() == null || existing().schoolId == getSchoolId()) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lastEntryTime', 'lastExitTime', 'status_presenca', 'ultimo_acesso', 'updatedAt']));

      allow delete: if isInstituicao();
    }

    // ==========================================================
    // 3. Coleção: classStats/{classId}
    // ==========================================================
    match /classStats/{classId} {
      allow get, list: if isInstituicao() || (isProfessor() && isTeacherOfClass(classId)) || (isProfessor() && (getSchoolId() == null || resource.data.schoolId == getSchoolId()));
      allow create, update, delete: if isInstituicao();
    }

    // ==========================================================
    // 4. Coleção: accessLogs/{logId}
    // ==========================================================
    match /accessLogs/{logId} {
      allow get, list: if isInstituicao() ||
                          (isProfessor() && (getSchoolId() == null || resource.data.schoolId == getSchoolId())) ||
                          (isPai() && isParentOfStudent(resource.data.studentId));

      allow create: if isTerminal() || isInstituicao() || (isSignedIn() && isValidId(logId));
      allow update: if isInstituicao();
      allow delete: if isInstituicao();
    }

    // ==========================================================
    // 5. Coleção: notifications/{notificationId}
    // ==========================================================
    match /notifications/{notificationId} {
      allow get, list: if isInstituicao() ||
                          (isProfessor() && (getSchoolId() == null || resource.data.schoolId == getSchoolId())) ||
                          (isPai() && (
                            resource.data.targetUserUid == request.auth.uid ||
                            resource.data.targetScope == 'broadcast' ||
                            (resource.data.studentId != null && isParentOfStudent(resource.data.studentId))
                          ));

      allow create: if isInstituicao() ||
                       (isProfessor() && incoming().type in ['reunion', 'warning', 'praise', 'broadcast'] && incoming().senderRole == 'professor') ||
                       isTerminal();

      allow update: if (
        isPai() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'updatedAt'])
      ) || isInstituicao();

      allow delete: if isInstituicao();
    }

    // ==========================================================
    // 6. Coleção: medicalClinics/{clinicId}
    // ==========================================================
    match /medicalClinics/{clinicId} {
      allow get, list: if isSignedIn(); // Catálogo público para todos autenticados
      allow create, update, delete: if isInstituicao();
    }

    // ==========================================================
    // 7. Coleção: grades/{gradeId} (Mini Pautas / Boletins)
    // ==========================================================
    match /grades/{gradeId} {
      allow get, list: if isInstituicao() ||
                          (isProfessor() && (isTeacherOfClass(resource.data.classId) || resource.data.teacherId == request.auth.uid || (getSchoolId() == null || resource.data.schoolId == getSchoolId()))) ||
                          (isPai() && isParentOfStudent(resource.data.studentId));

      // Professor cria como draft ou pending_approval
      allow create: if (
        isProfessor() &&
        incoming().teacherId == request.auth.uid &&
        incoming().status in ['draft', 'pending_approval']
      ) || isInstituicao();

      // Professor edita/deleta enquanto draft
      allow update: if (
        isProfessor() &&
        existing().teacherId == request.auth.uid &&
        existing().status in ['draft', 'rejected'] &&
        incoming().status in ['draft', 'pending_approval']
      ) || isInstituicao();

      allow delete: if (isProfessor() && existing().teacherId == request.auth.uid && existing().status == 'draft') || isInstituicao();
    }

    // ==========================================================
    // 8. Coleção: studentMedical/{studentId} (Guia Médica)
    // ==========================================================
    match /studentMedical/{studentId} {
      allow get, list: if isInstituicao() ||
                          (isProfessor() && (isTeacherOfClass(resource.data.classId) || (getSchoolId() == null || resource.data.schoolId == getSchoolId()))) ||
                          (isPai() && isParentOfStudent(studentId)) ||
                          isTerminal();

      allow create, update: if isInstituicao() ||
                               (isPai() && isParentOfStudent(studentId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emergencyPhone', 'emergencyContactName', 'allergies', 'chronicConditions', 'notes', 'updatedAt']));

      allow delete: if isInstituicao();
    }

    // ==========================================================
    // Coleções Legadas para Compatibilidade
    // ==========================================================
    match /alunos/{alunoId} {
      allow read: if isSignedIn();
      allow create, delete: if isInstituicao();
      allow update: if isInstituicao() || isProfessor() || (isPai() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guia_medica', 'status_presenca']));
    }

    match /turmas/{turmaId} {
      allow read: if isSignedIn();
      allow write: if isInstituicao();
    }

    match /turmas_professores/{assocId} {
      allow read: if isSignedIn();
      allow write: if isInstituicao();
    }

    match /mini_pautas/{pautaId} {
      allow read: if isSignedIn();
      allow write: if isInstituicao() || isProfessor();
    }

    match /presencas_biometricas/{presencaId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isInstituicao();
    }

    match /terminals/{terminalId} {
      allow read, write: if isInstituicao();
    }
  }
}
