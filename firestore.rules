rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================================
    // Helper Functions (RBAC, Multi-tenancy & Custom Claims)
    // ==========================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getRole() {
      return request.auth.token.role != null
        ? request.auth.token.role
        : (userExists() ? getUserDoc().role : 'pai');
    }

    function getSchoolId() {
      return request.auth.token.schoolId != null
        ? request.auth.token.schoolId
        : (userExists() && getUserDoc().schoolId != null ? getUserDoc().schoolId : null);
    }

    function isInstituicao() {
      return isSignedIn() && (getRole() == 'instituicao' || getRole() == 'admin' || request.auth.token.admin == true);
    }

    function isProfessor() {
      return isSignedIn() && (getRole() == 'professor');
    }

    function isPai() {
      return isSignedIn() && (getRole() == 'pai' || getRole() == 'encarregado');
    }

    function isTerminal() {
      return isSignedIn() && (getRole() == 'terminal');
    }

    function isParentOfStudent(studentId) {
      return isPai() && (
        (request.auth.token.studentIds != null && studentId in request.auth.token.studentIds) ||
        (request.auth.token.studentId != null && request.auth.token.studentId == studentId) ||
        (userExists() && getUserDoc().studentIds != null && studentId in getUserDoc().studentIds) ||
        (userExists() && getUserDoc().studentId != null && getUserDoc().studentId == studentId) ||
        (userExists() && getUserDoc().childrenIds != null && studentId in getUserDoc().childrenIds)
      );
    }

    function isTeacherOfClass(classId) {
      return isProfessor() && (
        (request.auth.token.classIds != null && classId in request.auth.token.classIds) ||
        (userExists() && getUserDoc().classIds != null && classId in getUserDoc().classIds)
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ==========================================================
    // 1. Coleção: users/{userId}
    // ==========================================================
    match /users/{userId} {
      allow get, list: if true;
      allow create: if isInstituicao() || (isOwner(userId) && incoming().role in ['pai', 'professor', 'instituicao', 'encarregado']) || !exists(/databases/$(database)/documents/users/$(userId));
      allow update: if (
        isOwner(userId) &&
        incoming().role == existing().role &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'avatarUrl', 'nome', 'telefone', 'updatedAt', 'title', 'studentId', 'studentIds', 'childrenIds', 'classIds'])
      ) || isInstituicao();
      allow delete: if isInstituicao();
    }

    // ==========================================================
    // 2. Coleção: students/{studentId}
    // ==========================================================
    match /students/{studentId} {
      allow get, list: if true;
      allow create: if isInstituicao() || !exists(/databases/$(database)/documents/students/$(studentId));
      allow update: if isInstituicao() ||
                       (isProfessor() && (getSchoolId() == null || existing().schoolId == getSchoolId()) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lastEntryTime', 'lastExitTime', 'status_presenca', 'ultimo_acesso', 'updatedAt'])) ||
                       (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lastEntryTime', 'lastExitTime', 'status_presenca', 'ultimo_acesso', 'updatedAt']));
      allow delete: if isInstituicao();
    }

    // ==========================================================
    // 3. Coleção: classStats/{classId}
    // ==========================================================
    match /classStats/{classId} {
      allow get, list: if true;
      allow create, update, delete: if isInstituicao() || isSignedIn() || !exists(/databases/$(database)/documents/classStats/$(classId));
    }

    // ==========================================================
    // 4. Coleção: accessLogs/{logId}
    // ==========================================================
    match /accessLogs/{logId} {
      allow get, list: if true;
      allow create: if true;
      allow update: if isInstituicao();
      allow delete: if isInstituicao();
    }

    // ==========================================================
    // 5. Coleção: notifications/{notificationId}
    // ==========================================================
    match /notifications/{notificationId} {
      allow get, list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isInstituicao();
    }

    // ==========================================================
    // 6. Coleção: medicalClinics/{clinicId}
    // ==========================================================
    match /medicalClinics/{clinicId} {
      allow get, list: if true;
      allow create, update, delete: if isInstituicao() || !exists(/databases/$(database)/documents/medicalClinics/$(clinicId));
    }

    // ==========================================================
    // 7. Coleção: grades/{gradeId} (Mini Pautas / Boletins)
    // ==========================================================
    match /grades/{gradeId} {
      allow get, list: if true;
      allow create, update: if isInstituicao() || isProfessor() || isSignedIn() || !exists(/databases/$(database)/documents/grades/$(gradeId));
      allow delete: if isInstituicao() || (isProfessor() && existing().teacherId == request.auth.uid && existing().status == 'draft');
    }

    // ==========================================================
    // 8. Coleção: studentMedical/{studentId} (Guia Médica)
    // ==========================================================
    match /studentMedical/{studentId} {
      allow get, list: if true;
      allow create, update: if isInstituicao() || isPai() || isSignedIn() || !exists(/databases/$(database)/documents/studentMedical/$(studentId));
      allow delete: if isInstituicao();
    }

    // ==========================================================
    // Coleções Legadas e Complementares
    // ==========================================================
    match /alunos/{alunoId} {
      allow read: if true;
      allow create: if isInstituicao() || !exists(/databases/$(database)/documents/alunos/$(alunoId));
      allow update: if isInstituicao() || isProfessor() || (isPai() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guia_medica', 'status_presenca'])) || isSignedIn();
      allow delete: if isInstituicao();
    }

    match /turmas/{turmaId} {
      allow read: if true;
      allow write: if true;
    }

    match /turmas_professores/{assocId} {
      allow read: if true;
      allow write: if true;
    }

    match /mini_pautas/{pautaId} {
      allow read: if true;
      allow write: if true;
    }

    match /presencas_biometricas/{presencaId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isInstituicao() || isSignedIn();
    }

    match /terminals/{terminalId} {
      allow read, write: if true;
    }
  }
}
