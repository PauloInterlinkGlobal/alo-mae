{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Dados de autenticação, perfil e permissões dos usuários do sistema.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["pai", "professor", "instituicao", "encarregado", "admin"] },
        "avatarUrl": { "type": "string" },
        "schoolId": { "type": "string" },
        "title": { "type": "string" },
        "studentId": { "type": "string" },
        "studentIds": { "type": "array" },
        "classIds": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "name", "email", "phone", "role", "schoolId"]
    },
    "Student": {
      "title": "Student",
      "description": "Dados cadastrais e identificação biométrica dos alunos.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "matricula": { "type": "string" },
        "name": { "type": "string" },
        "classId": { "type": "string" },
        "className": { "type": "string" },
        "schoolId": { "type": "string" },
        "parentName": { "type": "string" },
        "parentPhone": { "type": "string" },
        "parentEmail": { "type": "string" },
        "photoUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["present", "absent", "late"] },
        "lastEntryTime": { "type": "string" },
        "lastExitTime": { "type": "string" },
        "biometricCode": { "type": "string" },
        "insurancePolicyId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "matricula", "name", "classId", "className", "schoolId", "parentName", "parentPhone", "parentEmail", "status", "biometricCode", "insurancePolicyId"]
    },
    "ClassStat": {
      "title": "ClassStat",
      "description": "Estatísticas agregadas de assiduidade e notas por turma.",
      "type": "object",
      "properties": {
        "classId": { "type": "string" },
        "className": { "type": "string" },
        "teacherName": { "type": "string" },
        "room": { "type": "string" },
        "totalStudents": { "type": "number" },
        "presentsToday": { "type": "number" },
        "absentsToday": { "type": "number" },
        "latesToday": { "type": "number" },
        "monthlyPresents": { "type": "number" },
        "monthlyAbsences": { "type": "number" },
        "monthlyLates": { "type": "number" },
        "frequencyRate": { "type": "number" },
        "schoolId": { "type": "string" },
        "averageGrade": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["classId", "className", "teacherName", "room", "totalStudents", "schoolId"]
    },
    "AccessLog": {
      "title": "AccessLog",
      "description": "Registros de entrada e saída biométrica e presencial dos alunos.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentPhoto": { "type": "string" },
        "className": { "type": "string" },
        "schoolId": { "type": "string" },
        "type": { "type": "string", "enum": ["entry", "exit"] },
        "timestamp": { "type": "string" },
        "date": { "type": "string" },
        "location": { "type": "string" },
        "method": { "type": "string", "enum": ["facial", "fingerprint", "manual", "digital"] },
        "receiptCode": { "type": "string" },
        "notified": { "type": "boolean" },
        "notifiedRecipient": { "type": "string" },
        "statusNote": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "studentId", "studentName", "className", "schoolId", "type", "timestamp", "date", "receiptCode"]
    },
    "SchoolNotification": {
      "title": "SchoolNotification",
      "description": "Notificações push, avisos, convocações e comunicados escolares.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["reunion", "warning", "broadcast", "praise", "access_entry", "access_exit", "medical", "grade_approved"] },
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "className": { "type": "string" },
        "schoolId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderRole": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "isRead": { "type": "boolean" },
        "targetUserUid": { "type": "string" },
        "reunionDate": { "type": "string" },
        "reunionTime": { "type": "string" },
        "receiptCode": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "type", "title", "message", "schoolId", "senderName", "senderRole", "date", "time", "isRead"]
    },
    "MedicalClinic": {
      "title": "MedicalClinic",
      "description": "Rede de clínicas e hospitais credenciados do seguro escolar.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "specialty": { "type": "string" },
        "address": { "type": "string" },
        "district": { "type": "string" },
        "distanceKm": { "type": "string" },
        "timeMin": { "type": "string" },
        "emergencyPhone": { "type": "string" },
        "services": { "type": "array" },
        "imageUrl": { "type": "string" },
        "available24h": { "type": "boolean" },
        "schoolId": { "type": "string" }
      },
      "required": ["id", "name", "specialty", "address", "emergencyPhone", "available24h", "schoolId"]
    },
    "Grade": {
      "title": "Grade",
      "description": "Mini pautas e boletins de notas lançadas pelos professores e auditadas pela instituição.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "classId": { "type": "string" },
        "className": { "type": "string" },
        "subject": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "grade": { "type": "number" },
        "feedback": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "pending_approval", "approved", "rejected"] },
        "schoolId": { "type": "string" },
        "approvedBy": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "studentId", "studentName", "classId", "className", "subject", "teacherId", "teacherName", "grade", "status", "schoolId"]
    },
    "StudentMedical": {
      "title": "StudentMedical",
      "description": "Guia médica individual, apólice de seguro e contatos de emergência do aluno.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "classId": { "type": "string" },
        "schoolId": { "type": "string" },
        "insurancePolicyId": { "type": "string" },
        "insuranceProvider": { "type": "string" },
        "policyType": { "type": "string", "enum": ["basic", "comprehensive", "hospital", "other"] },
        "coverage": { "type": "array" },
        "validityStart": { "type": "string" },
        "validityEnd": { "type": "string" },
        "emergencyPhone": { "type": "string" },
        "emergencyContactName": { "type": "string" },
        "allergies": { "type": "array" },
        "chronicConditions": { "type": "array" },
        "notes": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["studentId", "studentName", "classId", "schoolId", "insurancePolicyId", "insuranceProvider", "policyType", "coverage", "validityStart", "validityEnd", "emergencyPhone", "emergencyContactName"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Perfis de usuários do sistema escolar."
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Cadastro e estado dos alunos."
    },
    "/classStats/{classId}": {
      "schema": { "$ref": "#/entities/ClassStat" },
      "description": "Estatísticas agregadas de presença e frequência de turmas."
    },
    "/accessLogs/{logId}": {
      "schema": { "$ref": "#/entities/AccessLog" },
      "description": "Registos de acessos biométricos de entrada e saída."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/SchoolNotification" },
      "description": "Notificações e comunicados escolares em tempo real."
    },
    "/medicalClinics/{clinicId}": {
      "schema": { "$ref": "#/entities/MedicalClinic" },
      "description": "Clínicas médicas e hospitais credenciados."
    },
    "/grades/{gradeId}": {
      "schema": { "$ref": "#/entities/Grade" },
      "description": "Mini pautas e notas de avaliação por disciplina."
    },
    "/studentMedical/{studentId}": {
      "schema": { "$ref": "#/entities/StudentMedical" },
      "description": "Guias médicas, seguro escolar e histórico de saúde dos alunos."
    }
  }
}
