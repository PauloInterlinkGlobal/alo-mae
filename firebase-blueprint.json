{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Dados de autenticação, perfil e permissões dos usuários do sistema.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["pai", "professor", "instituicao", "encarregado", "admin"] },
        "avatarUrl": { "type": "string" },
        "schoolId": { "type": "string" },
        "title": { "type": "string" },
        "studentId": { "type": "string" },
        "studentIds": { "type": "array" },
        "classIds": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "name", "email", "phone", "role", "schoolId"]
    },
    "Student": {
      "title": "Student",
      "description": "Dados cadastrais e identificação biométrica dos alunos.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "matricula": { "type": "string" },
        "name": { "type": "string" },
        "classId": { "type": "string" },
        "className": { "type": "string" },
        "schoolId": { "type": "string" },
        "parentName": { "type": "string" },
        "parentPhone": { "type": "string" },
        "parentEmail": { "type": "string" },
        "photoUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["present", "absent", "late"] },
        "lastEntryTime": { "type": "string" },
        "lastExitTime": { "type": "string" },
        "biometricCode": { "type": "string" },
        "insurancePolicyId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "matricula", "name", "classId", "className", "schoolId", "parentName", "parentPhone", "parentEmail", "status", "biometricCode", "insurancePolicyId"]
    },
    "ClassStat": {
      "title": "ClassStat",
      "description": "Estatísticas agregadas de assiduidade e notas por turma.",
      "type": "object",
      "properties": {
        "classId": { "type": "string" },
        "className": { "type": "string" },
        "teacherName": { "type": "string" },
        "room": { "type": "string" },
        "totalStudents": { "type": "number" },
        "presentsToday": { "type": "number" },
        "absentsToday": { "type": "number" },
        "latesToday": { "type": "number" },
        "monthlyPresents": { "type": "number" },
        "monthlyAbsences": { "type": "number" },
        "monthlyLates": { "type": "number" },
        "frequencyRate": { "type": "number" },
        "schoolId": { "type": "string" },
        "averageGrade": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["classId", "className", "teacherName", "room", "totalStudents", "schoolId"]
    },
    "AccessLog": {
      "title": "AccessLog",
      "description": "Registros de entrada e saída biométrica e presencial dos alunos.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentPhoto": { "type": "string" },
        "className": { "type": "string" },
        "schoolId": { "type": "string" },
        "type": { "type": "string", "enum": ["entry", "exit"] },
        "timestamp": { "type": "string" },
        "date": { "type": "string" },
        "location": { "type": "string" },
        "method": { "type": "string", "enum": ["facial", "fingerprint", "manual", "digital"] },
        "receiptCode": { "type": "string" },
        "notified": { "type": "boolean" },
        "notifiedRecipient": { "type": "string" },
        "statusNote": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "studentId", "studentName", "className", "schoolId", "type", "timestamp", "date", "receiptCode"]
    },
    "SchoolNotification": {
      "title": "SchoolNotification",
      "description": "Notificações push, avisos, convocações e comunicados escolares.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["reunion", "warning", "broadcast", "praise", "access_entry", "access_exit", "medical", "grade_approved"] },
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "className": { "type": "string" },
        "schoolId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderRole": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "isRead": { "type": "boolean" },
        "targetUserUid": { "type": "string" },
        "reunionDate": { "type": "string" },
        "reunionTime": { "type": "string" },
        "receiptCode": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "type", "title", "message", "schoolId", "senderName", "senderRole", "date", "time", "isRead"]
    },
    "MedicalClinic": {
      "title": "MedicalClinic",
      "description": "Rede de clínicas e hospitais credenciados do seguro escolar.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "specialty": { "type": "string" },
        "address": { "type": "string" },
        "district": { "type": "string" },
        "distanceKm": { "type": "string" },
        "timeMin": { "type": "string" },
        "emergencyPhone": { "type": "string" },
        "services": { "type": "array" },
        "imageUrl": { "type": "string" },
        "available24h": { "type": "boolean" },
        "schoolId": { "type": "string" }
      },
      "required": ["id", "name", "specialty", "address", "emergencyPhone", "available24h", "schoolId"]
    },
    "Grade": {
      "title": "Grade",
      "description": "Mini pautas e boletins de notas lançadas pelos professores e auditadas pela instituição.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "classId": { "type": "string" },
        "className": { "type": "string" },
        "subject": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "grade": { "type": "number" },
        "feedback": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "pending_approval", "approved", "rejected"] },
        "schoolId": { "type": "string" },
        "approvedBy": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "studentId", "studentName", "classId", "className", "subject", "teacherId", "teacherName", "grade", "status", "schoolId"]
    },
    "StudentMedical": {
      "title": "StudentMedical",
      "description": "Guia médica individual, apólice de seguro e contatos de emergência do aluno.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "classId": { "type": "string" },
        "schoolId": { "type": "string" },
        "insurancePolicyId": { "type": "string" },
        "insuranceProvider": { "type": "string" },
        "policyType": { "type": "string", "enum": ["basic", "comprehensive", "hospital", "other"] },
        "coverage": { "type": "array" },
        "validityStart": { "type": "string" },
        "validityEnd": { "type": "string" },
        "emergencyPhone": { "type": "string" },
        "emergencyContactName": { "type": "string" },
        "allergies": { "type": "array" },
        "chronicConditions": { "type": "array" },
        "notes": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["studentId", "studentName", "classId", "schoolId", "insurancePolicyId", "insuranceProvider", "policyType", "coverage", "validityStart", "validityEnd", "emergencyPhone", "emergencyContactName"]
    },
    "TeacherListing": {
      "title": "TeacherListing",
      "description": "Anúncios e ofertas de aulas de apoio, explicações e reforço escolar criados por professores.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "institutionId": { "type": "string" },
        "teacherUid": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "subjectId": { "type": "string" },
        "category": { "type": "string", "enum": ["tutoring", "home_tutoring", "online", "exam_preparation", "academic_support", "other"] },
        "modality": { "type": "string", "enum": ["home", "online", "school", "other"] },
        "price": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "pending", "approved", "rejected", "suspended"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "institutionId", "teacherUid", "title", "category", "modality", "status"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Canal de conversação interna seguro entre Professor e Encarregado vinculado ao Educando.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "institutionId": { "type": "string" },
        "participantIds": { "type": "array" },
        "teacherUid": { "type": "string" },
        "guardianUid": { "type": "string" },
        "studentId": { "type": "string" },
        "subjectId": { "type": "string" },
        "context": { "type": "string", "enum": ["student", "academic", "announcement", "medical", "general"] },
        "lastMessage": { "type": "string" },
        "lastMessageAt": { "type": "string" },
        "active": { "type": "boolean" },
        "teacherName": { "type": "string" },
        "guardianName": { "type": "string" },
        "studentName": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "institutionId", "participantIds", "teacherUid", "guardianUid", "studentId", "context", "active"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Mensagem individual do chat com suporte a texto, anexo e confirmação de leitura.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderUid": { "type": "string" },
        "receiverUid": { "type": "string" },
        "text": { "type": "string" },
        "attachmentUrl": { "type": "string" },
        "attachmentType": { "type": "string", "enum": ["image", "document", "pdf"] },
        "attachmentName": { "type": "string" },
        "read": { "type": "boolean" },
        "readAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "senderUid", "read", "createdAt"]
    },
    "MedicalGuide": {
      "title": "MedicalGuide",
      "description": "Guia médica de atendimento hospitalar e urgência escolar emitida para um educando.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "guideNumber": { "type": "string" },
        "institutionId": { "type": "string" },
        "schoolName": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentPhoto": { "type": "string" },
        "studentMatricula": { "type": "string" },
        "className": { "type": "string" },
        "guardianUid": { "type": "string" },
        "guardianName": { "type": "string" },
        "guardianPhoto": { "type": "string" },
        "emergencyContactPhone": { "type": "string" },
        "clinicId": { "type": "string" },
        "clinicName": { "type": "string" },
        "clinicAddress": { "type": "string" },
        "clinicEmergencyPhone": { "type": "string" },
        "insuranceProviderName": { "type": "string" },
        "insurancePolicyNumber": { "type": "string" },
        "insuranceType": { "type": "string" },
        "hasInsurance": { "type": "boolean" },
        "coveragesSummary": { "type": "string" },
        "reason": { "type": "string" },
        "priority": { "type": "string", "enum": ["normal", "urgent", "emergency"] },
        "status": { "type": "string", "enum": ["draft", "issued", "accepted", "in_service", "completed", "cancelled"] },
        "issuedByUid": { "type": "string" },
        "issuedByName": { "type": "string" },
        "issuedAt": { "type": "string" },
        "expiresAt": { "type": "string" },
        "notes": { "type": "string" },
        "validationUrl": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "guideNumber", "institutionId", "studentId", "studentName", "clinicId", "clinicName", "priority", "status", "issuedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Registo de auditoria de ações sensíveis (ex: impressão de guia médica).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "institutionId": { "type": "string" },
        "actorUid": { "type": "string" },
        "actorName": { "type": "string" },
        "actorRole": { "type": "string" },
        "action": { "type": "string" },
        "entityType": { "type": "string" },
        "entityId": { "type": "string" },
        "description": { "type": "string" },
        "timestamp": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "actorUid", "action", "timestamp"]
    },
    "AttendanceEvent": {
      "title": "AttendanceEvent",
      "description": "Eventos atômicos de presença biométrica com anti-spoofing e comprovação.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "classId": { "type": "string" },
        "className": { "type": "string" },
        "schoolId": { "type": "string" },
        "deviceId": { "type": "string" },
        "location": { "type": "string" },
        "date": { "type": "string" },
        "dateKey": { "type": "string" },
        "timestamp": { "type": "string" },
        "type": { "type": "string", "enum": ["ENTRADA", "SAIDA_TEMPORARIA", "RETORNO", "SAIDA_OFICIAL"] },
        "method": { "type": "string", "enum": ["FACIAL", "FINGERPRINT", "MANUAL"] },
        "confidence": { "type": "number" },
        "livenessPassed": { "type": "boolean" },
        "receiptCode": { "type": "string" },
        "synced": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "studentId", "dateKey", "timestamp", "type", "method", "receiptCode"]
    },
    "DailyAttendance": {
      "title": "DailyAttendance",
      "description": "Resumo diário e máquina de estados de assiduidade do educando.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "classId": { "type": "string" },
        "className": { "type": "string" },
        "schoolId": { "type": "string" },
        "date": { "type": "string" },
        "dateKey": { "type": "string" },
        "firstEntryAt": { "type": "string" },
        "officialExitAt": { "type": "string" },
        "currentState": { "type": "string", "enum": ["AUSENTE", "PRESENTE", "FORA_TEMPORARIAMENTE", "SAIU_OFICIALMENTE"] },
        "totalEvents": { "type": "number" },
        "lastEventAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "studentId", "dateKey", "currentState"]
    }
  },
  "firestore": {
    "/attendanceEvents/{eventId}": {
      "schema": { "$ref": "#/entities/AttendanceEvent" },
      "description": "Eventos biométricos de presença atômicos registrados pelos totens."
    },
    "/dailyAttendance/{dailyId}": {
      "schema": { "$ref": "#/entities/DailyAttendance" },
      "description": "Resumo diário consolidado por aluno com máquina de estados de presença."
    },
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Perfis de usuários do sistema escolar."
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Cadastro e estado dos alunos."
    },
    "/classStats/{classId}": {
      "schema": { "$ref": "#/entities/ClassStat" },
      "description": "Estatísticas agregadas de presença e frequência de turmas."
    },
    "/accessLogs/{logId}": {
      "schema": { "$ref": "#/entities/AccessLog" },
      "description": "Registos de acessos biométricos de entrada e saída."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/SchoolNotification" },
      "description": "Notificações e comunicados escolares em tempo real."
    },
    "/medicalClinics/{clinicId}": {
      "schema": { "$ref": "#/entities/MedicalClinic" },
      "description": "Clínicas médicas e hospitais credenciados."
    },
    "/grades/{gradeId}": {
      "schema": { "$ref": "#/entities/Grade" },
      "description": "Mini pautas e notas de avaliação por disciplina."
    },
    "/studentMedical/{studentId}": {
      "schema": { "$ref": "#/entities/StudentMedical" },
      "description": "Guias médicas, seguro escolar e histórico de saúde dos alunos."
    },
    "/medicalGuides/{guideId}": {
      "schema": { "$ref": "#/entities/MedicalGuide" },
      "description": "Guias médicas autorizadas para impressão e validação hospitalar."
    },
    "/auditLogs/{auditId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Trilha de auditoria e conformidade institucional."
    },
    "/teacherListings/{listingId}": {
      "schema": { "$ref": "#/entities/TeacherListing" },
      "description": "Mural de aulas particulares e explicações de professores."
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Conversas auditadas entre professores e encarregados sobre educandos."
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Mensagens instantâneas com estados e anexos."
    }
  }
}
